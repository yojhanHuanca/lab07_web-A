PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/express-mongo-auth
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Solo se usan al crear el primer administrador. No modifican cuentas existentes.
ADMIN_EMAIL=admin@nexo.local
# Usa comillas: # inicia un comentario en dotenv si la contraseña no está entre comillas.
ADMIN_PASSWORD=""
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=Principal
ADMIN_PHONE=999999999
ADMIN_BIRTHDATE=1990-01-01
